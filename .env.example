# Copy this file to .env and fill in real values. Never commit .env itself.

AWS_REGION=us-east-1

S3_BUCKET_NAME=your-s3-bucket-name

DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=csc3074_db
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# AWS Cognito — sign-in for guests and staff. Staff must be members of the
# "Admins" group in the User Pool to reach /admin. See README.md for the
# Console setup steps.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_CLIENT_SECRET=your-app-client-secret
COGNITO_DOMAIN=your-domain-prefix.auth.us-east-1.amazoncognito.com
